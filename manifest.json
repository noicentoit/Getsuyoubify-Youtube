{   "browser_specific_settings": {
        "gecko": {
            "id": "getsuyoubify@noicentoit",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "manifest_version": 2,
    "name": "YouTube Getsuyoubify",
    "version": "1.0.1",
    "icons": {
        "96": "icon.png"
    },
    "description": "Modify YouTube thumbnails to include Hololive VTuber Otonose Kanade",
    "browser_action": {
        "default_popup": "settings.html"
    },
    "permissions": [
        "storage",
        "*://*.youtube.com/*"
    ],
    "content_scripts": [{
        "matches": ["*://*.youtube.com/*"],
        "js": ["mrbeastify.js"],
        "run_at": "document_idle"
    }],
    "web_accessible_resources": [
        "images/*.png",
        "images/*.json"
    ]
}